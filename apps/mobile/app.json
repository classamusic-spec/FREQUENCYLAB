{
  "expo": {
    "name": "Frequency Lab",
    "slug": "frequency-lab",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "frequencylab",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F4F6F9",
    "splash": {
      "image": "./assets/splash-icon.png",
      "imageWidth": 180,
      "backgroundColor": "#F4F6F9",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frequencylab.app",
      "requireFullScreen": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSHealthShareUsageDescription": "FREQUENCY LAB can read heart rate and heart-rate variability around a session so you can see how your body responded. This is optional and the app works fully without it.",
        "NSHealthUpdateUsageDescription": "FREQUENCY LAB can record completed sessions as mindful minutes. This is optional.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.frequencylab.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F6F9"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F4F6F9",
          "resizeMode": "contain"
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosForegroundService": true,
          "androidForegroundService": true,
          "androidPermissions": [
            "FOREGROUND_SERVICE",
            "WAKE_LOCK"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
