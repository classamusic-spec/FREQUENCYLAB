{
  "name": "frequencylab",
  "version": "0.1.0",
  "private": true,
  "description": "FREQUENCY LAB — a personal psychoacoustic laboratory.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @frequencylab/dsp-core",
    "test": "npm run test --workspace @frequencylab/dsp-core",
    "test:dsp": "npm run test --workspace @frequencylab/dsp-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "mobile": "npm run start --workspace @frequencylab/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
